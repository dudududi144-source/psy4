# Copy to .env.local and fill with REAL values (rotated tokens).
# NEVER commit .env.local — it is gitignored.
# These secrets must be rotated if they were ever exposed (e.g. in chat, in a committed file).

# ── Turso (SQLite cloud sync for learning state + presets) ──
TURSO_DATABASE_URL=libsql://your-db-name-your-org.turso.io
TURSO_AUTH_TOKEN=

# ── Supabase (auth + user accounts) ──
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Cloudflare (Pages deploy) ──
CF_API_TOKEN=
CF_ACCOUNT_ID=

# ── GitHub (optional, for CI/CD or pushing from local) ──
# Use a fine-grained PAT with contents:write on the repo only.
GH_TOKEN=
